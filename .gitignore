# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.local

# Data: 整体 ignore (派生数据: parquet/jsonl/cache 等)
data/

# 但保留手工维护的 fetcher log (跨机器共享 fetch 进度)
!data/fetch_log.jsonl

# 信号存档 (signal_tracker.py 维护, 应入库以便回测胜率)
!data/signals/
!data/signals/**

# SQLite 数据库
*.db
*.sqlite3

# Docs (2026-09-18 拆掉: skill 自动产物全 ignore, 手工文档迁 handbook/)
# docs/ 整目录不入库, 历史存量已删除
docs/
# handbook/ 是手工维护的知识库, 全入库
!handbook/
!handbook/**

# Cache
.cache/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Coverage
.coverage
htmlcov/
.coverage.*

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Claude
.claude/*
# Claude Code Skills 是项目级, 应入库 (settings.local.json 仍忽略)
!.claude/skills/
!.claude/skills/**

# Mavis plan 笔记 (2026-07-31)
.zcode/

# Obsidian (2026-11-16 改: 整个配置目录不入库 —— 含 per-window 状态 / 最近打开文件 /
#   个人偏好; 之前只忽略 workspace.json, 2026-11-04 起曾把 app/appearance 入库跨机同步,
#   现改为整体忽略, 跨机配置同步走 Obsidian Sync / iCloud 等工具)
.obsidian/
Untitled.canvas

# 本地环境变量 (含 tushare token 等敏感信息)
.env
*.py.bak

# safe_fs 原子写备份 (2026-11-02 加: atomic_write_json 写前备份, 不入库)
*.bak-*
.claude/skills/_shared/.DS_Store
