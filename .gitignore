# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.local

# Data: 整体 ignore (派生数据: parquet/jsonl/cache/oversold 等)
data/

# 但保留手工维护的 fetcher log (跨机器共享 fetch 进度)
!data/fetch_log.jsonl

# 超跌股 watchlist (auto-generated, 跟 git 备份)
!data/watchlist_oversold.json

# 信号存档 (signal_tracker.py 维护, 应入库以便回测胜率)
!data/signals/
!data/signals/**

# app/data/ 是源码目录, 不受上方 data/ 规则影响
!app/data/

# SQLite 数据库
*.db
*.sqlite3

# Docs (2026-09-18 拆掉: skill 自动产物全 ignore, 手工文档迁 handbook/)
# docs/ 整目录不入库, 历史存量已删除
docs/
# handbook/ 是手工维护的知识库, 全入库
!handbook/
!handbook/**

# Cache
.cache/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Coverage
.coverage
htmlcov/
.coverage.*

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Claude
.claude/*
# Claude Code Skills 是项目级, 应入库 (settings.local.json 仍忽略)
!.claude/skills/
!.claude/skills/**

# Mavis plan 笔记 (2026-07-31)
.zcode/

# 本地环境变量 (含 tushare token 等敏感信息)
.env
*.py.bak
.claude/skills/_shared/.DS_Store
